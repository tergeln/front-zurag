{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "zurag-web",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference binding required by OpenNext; must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "zurag-web"
    }
  ],
  "images": {
    // next/image optimisation via Cloudflare Images (free plan: 5,000 unique transformations / month).
    "binding": "IMAGES"
  }
}
