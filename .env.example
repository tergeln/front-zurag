# Copy to .env.local and fill in from Supabase dashboard -> Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy anon key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare R2 (private photo storage). Server-only secrets: never prefix with NEXT_PUBLIC_.
# Cloudflare dashboard -> R2 -> Manage API tokens -> Object Read & Write, limited to this bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=zurag-photos
