# Copy to .env.local and fill in from Supabase dashboard -> Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy anon key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare R2 (private photo storage). Server-only secrets: never prefix with NEXT_PUBLIC_.
# Cloudflare dashboard -> R2 -> Manage API tokens -> Object Read & Write, limited to this bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=zurag-photos

# Supabase secret key (sb_secret_...). Server-only: confirms QPay payments, which arrive without a user session.
SUPABASE_SECRET_KEY=

# QPay merchant API v2. Credentials come from QPay (support@qpay.mn). Sandbox URL until launch.
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
# Random 64-hex secret that signs our callback URL.
QPAY_CALLBACK_SECRET=
# Public HTTPS address of this site; QPay must be able to reach {PUBLIC_SITE_URL}/api/qpay/callback.
PUBLIC_SITE_URL=

# Internal AI service (back-zurag/app/api.py). Same token as back-zurag/.env. Server-only.
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TOKEN=
